# GEMINI_API_KEY: kunci API Gemini yang dipakai server untuk dialog agen.
# Jika dikosongkan, aplikasi berjalan dalam mode offline dan memakai templat dialog.
GEMINI_API_KEY=

# GEMINI_MODEL: nama model Gemini (opsional).
# Jika dikosongkan, server memakai model bawaan yang didefinisikan di src/llm/config.ts.
GEMINI_MODEL=

# APP_URL: URL tempat aplikasi ini dihosting (opsional).
# Dipakai untuk tautan yang merujuk ke aplikasi sendiri.
APP_URL=
